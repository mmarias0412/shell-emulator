# Проверка команд этапа 4: ls, cd, clear, echo, history
vfs-info               # какая VFS сейчас загружена

ls                      # содержимое текущего каталога (корень)
cd docs                 # переход в подкаталог
ls                      # содержимое docs
cd 2024                 # переход ещё глубже (не менее 3 уровней)
ls                      # содержимое docs/2024
cd ..                   # вверх на один уровень
cd ..                   # снова вверх, обратно в корень
ls /docs/2024/notes     # абсолютный путь без смены текущего каталога
ls /images/logo.png     # ls на файле -> печатает только его имя

cd /nope                # ошибка: такого каталога нет
ls /nope                # ошибка: такого пути нет
cd /images/logo.png     # ошибка: это файл, а не каталог
cd a b                  # ошибка: слишком много аргументов

echo Привет, виртуальная файловая система!
#clear                   # очищает окно вывода
echo после очистки      # подтверждает, что эмулятор продолжает работать
history                 # список всех выполненных команд (виден и после clear)

